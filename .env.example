# DataChat AI Environment Variables
# ----------------------------------
# Copy this file to '.env' and fill in the values below.
# You only need ONE of these keys for the app to function, but providing multiple
# allows the app to fallback if one fails.

# Default order of preference: OpenAI -> Anthropic -> Groq
# You can force a specific provider by setting LLM_PROVIDER.

# Optional: Force a specific provider (openai, anthropic, or groq)
LLM_PROVIDER=groq

# 1. Groq (Fastest, Llama-3, Free Tier Available)
GROQ_API_KEY=your_groq_api_key_here

# 2. OpenAI (GPT-4o, Highly Reliable)
OPENAI_API_KEY=your_openai_api_key_here

# 3. Anthropic (Claude 3.5 Sonnet, Highly Reliable)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
